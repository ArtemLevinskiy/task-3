<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Бронювання номера №<%= room.roomNumber %></title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; background-color: #fcfcfc; display: flex; justify-content: center; align-items: center; height: 100vh; }
        .card { background: #fff; padding: 30px; border-radius: 10px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); max-width: 400px; width: 100%; }
        h2 { color: #2c3e50; margin-top: 0; }
        p { color: #666; font-size: 14px; }
        input { width: 100%; padding: 10px; margin-bottom: 12px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; }
        button { background: #27ae60; color: white; border: none; padding: 12px; border-radius: 6px; width: 100%; font-weight: bold; cursor: pointer; }
        button:hover { background: #219653; }
        .back-link { display: block; text-align: center; margin-top: 15px; color: #3498db; text-decoration: none; font-size: 14px; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Бронювання номера №<%= room.roomNumber %></h2>
        <p>Тип: <strong><%= room.roomType %></strong> | Стиль: <em><%= room.decorationStyle %></em></p>
        <p>Ціна: <strong><%= room.basePrice %> грн/ніч</strong></p>

        <form action="/book/<%= room._id %>" method="POST">
            <input type="text" name="clientName" placeholder="Ваше ім'я та прізвище" required>
            <input type="text" name="clientPhone" placeholder="Номер телефону" required>
            <button type="submit">Підтвердити бронювання</button>
        </form>

        <a href="/" class="back-link">← Скасувати і повернутися</a>
    </div>
</body>
</html>